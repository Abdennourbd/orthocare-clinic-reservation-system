# Ortho'Care Clinic — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# This file lists every variable the app reads, with a comment explaining each.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string for the app + Prisma CLI (migrations/seed).
# Local dev uses trust auth, so no password is needed for the OS-matching role.
# Staging/production: managed Postgres (Vercel Postgres or Neon), password URL.
DATABASE_URL="postgresql://USER@localhost:5432/orthocare_dev"

# Separate Postgres database used ONLY by automated tests (Vitest integration).
# Never point tests at dev or production data.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/orthocare_test"

# ── Messaging ───────────────────────────────────────────────────────────────
# Which MessageProvider implementation is active:
#   mock      -> logs every message to the SmsMessage table (dev/staging/test)
#   twilio    -> real SMS via Twilio (production)
#   whatsapp  -> real WhatsApp Business messages (production)
MESSAGE_PROVIDER="mock"

# Twilio (required when MESSAGE_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# WhatsApp Business (required when MESSAGE_PROVIDER=whatsapp)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── Vercel Blob (patient documents, Task 15) ────────────────────────────────
# Read-write token for the Vercel Blob store (patient X-rays/photos are stored
# privately, never as public URLs). Obtain from the Vercel project settings.
BLOB_READ_WRITE_TOKEN=""

# ── Cron (Task 9) ───────────────────────────────────────────────────────────
# Shared secret that authenticates Vercel Cron -> route handler calls.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Auth (Task 12) ──────────────────────────────────────────────────────────
# Site origin used for CSRF Origin/Referer checks and session cookie scoping.
# e.g. http://localhost:3000 locally; https://orthocare-clinic.vercel.app in prod.
APP_URL="http://localhost:3000"

# Seed-time password for the initial admin account (Task 3a). Comes from env,
# never hardcoded. Set this to a strong password before running `prisma db seed`.
# Not used in this task; present so the pattern is established early.
ADMIN_INITIAL_PASSWORD=""
