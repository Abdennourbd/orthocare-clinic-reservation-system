# Ortho'Care Clinic — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# This file lists every variable the app reads, with a comment explaining each.

# ── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL is what `npm run dev`, `prisma migrate`, and `prisma db seed`
# all read. Point it at a LOCAL Postgres database (e.g. orthocare_dev) — never
# at the shared production Neon database — so that manual testing and CLI
# commands can never touch real patient data.
#
# SECURITY: This string contains a live credential. Keep `.env` out of version
# control (it is gitignored). NEVER paste `DATABASE_URL` into chat, logs, or
# bug reports — if it is ever printed to output, treat it as exposed and
# rotate the password immediately.
DATABASE_URL="postgresql://USER@localhost:5432/orthocare_dev"

# Separate Postgres database used ONLY by automated tests (Vitest integration).
# Keep this pointing at a LOCAL database — never the shared one, so tests can't
# touch shared/dev data.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/orthocare_test"

# Optional: if the project's production database lives on Neon (or elsewhere),
# store that URL under a DIFFERENT key than DATABASE_URL. No tool in this
# project reads this key by design — it exists only so the value isn't lost.
# NEVER copy it into DATABASE_URL on a development machine: doing so would
# make `npm run dev`, `prisma migrate`, and the seed script write into real
# patient data.
NEON_PRODUCTION_DATABASE_URL_DO_NOT_USE_LOCALLY="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"

# ── Messaging ───────────────────────────────────────────────────────────────
# Which MessageProvider implementation is active:
#   mock      -> logs every message to the SmsMessage table (dev/staging/test)
#   twilio    -> real SMS via Twilio (production)
#   whatsapp  -> real WhatsApp Business messages (production)
MESSAGE_PROVIDER="mock"

# Twilio (required when MESSAGE_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# WhatsApp Business (required when MESSAGE_PROVIDER=whatsapp)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── Vercel Blob (patient documents, Task 15) ────────────────────────────────
# Read-write token for the Vercel Blob store (patient X-rays/photos are stored
# privately, never as public URLs). Obtain from the Vercel project settings.
BLOB_READ_WRITE_TOKEN=""

# ── Cron (Task 9) ───────────────────────────────────────────────────────────
# Shared secret that authenticates Vercel Cron -> route handler calls.
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`; the routes also
# accept the same secret via an `x-cron-secret` header for manual/curl triggers.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Auth (Task 12) ──────────────────────────────────────────────────────────
# Site origin used for CSRF Origin/Referer checks and session cookie scoping.
# e.g. http://localhost:3000 locally; https://orthocare-clinic.vercel.app in prod.
APP_URL="http://localhost:3000"

# HMAC key that signs staff session cookies (`__Host-orthocare_session`).
# REQUIRED in any environment where staff log in. Generate with:
#   openssl rand -hex 32
# Rotating it logs every staff member out (safe, non-destructive).
SESSION_SECRET=""

# Seed-time password for the initial admin account (Task 3a). Comes from env,
# never hardcoded. Set this to a strong password before running `prisma db seed`.
# Not used in this task; present so the pattern is established early.
ADMIN_INITIAL_PASSWORD=""

# Seed-time email for the initial admin account. Defaults to admin@orthocare.com
# when unset. Only read by the seed script; changing it does not rename an
# already-created admin user (use a DB update for that).
ADMIN_EMAIL=""
