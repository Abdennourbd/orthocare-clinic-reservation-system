# Ortho'Care Clinic — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# This file lists every variable the app reads, with a comment explaining each.
#
# Quick start for a new machine:
#   1. cp .env.example .env
#   2. Fill DATABASE_URL and TEST_DATABASE_URL (local Postgres, see below)
#   3. Generate the secrets:  openssl rand -hex 32   (SESSION_SECRET, CRON_SECRET)
#   4. Set ADMIN_INITIAL_PASSWORD (used only by `prisma db seed`)
#   5. Vercel Blob: create a PRIVATE store once, then copy the two BLOB_ values:
#        npx vercel blob create-store orthocare-radiographies --access private --yes
#      (the CLI writes them into .env.local — move them into .env and delete .env.local)
#   6. npm run db:migrate && npm run db:seed && npm run dev

# ── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL is what `npm run dev`, `prisma migrate`, and `prisma db seed`
# all read. Point it at a LOCAL Postgres database (e.g. orthocare_dev) — never
# at the shared production Neon database — so that manual testing and CLI
# commands can never touch real patient data.
#
# SECURITY: This string contains a live credential. Keep `.env` out of version
# control (it is gitignored). NEVER paste `DATABASE_URL` into chat, logs, or
# bug reports — if it is ever printed to output, treat it as exposed and
# rotate the password immediately.
DATABASE_URL="postgresql://USER@localhost:5432/orthocare_dev"

# Separate Postgres database used ONLY by automated tests (Vitest integration).
# Keep this pointing at a LOCAL database — never the shared one, so tests can't
# touch shared/dev data.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/orthocare_test"

# Optional: if the project's production database lives on Neon (or elsewhere),
# store that URL under a DIFFERENT key than DATABASE_URL. No tool in this
# project reads this key by design — it exists only so the value isn't lost.
# NEVER copy it into DATABASE_URL on a development machine: doing so would
# make `npm run dev`, `prisma migrate`, and the seed script write into real
# patient data.
NEON_PRODUCTION_DATABASE_URL_DO_NOT_USE_LOCALLY="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"

# ── Messaging (Task 22: real providers) ───────────────────────────────────
# Which MessageProvider implementation is active:
#   mock            -> logs every message to the SmsMessage table (dev/staging/test)
#   twilio          -> real SMS via Twilio (production, SMS-only)
#   whatsapp        -> real WhatsApp Business messages (production, WhatsApp-only)
#   whatsapp-first  -> try WhatsApp, fall back to Twilio SMS (production default;
#                      ~90% of DZ numbers are on WhatsApp at ~1/10th the SMS cost)
MESSAGE_PROVIDER="mock"

# Twilio (required when MESSAGE_PROVIDER=twilio or whatsapp-first)
# SID starts with "AC…"; FROM must be E.164. NOTE: SMS to Algeria needs an
# alphanumeric sender ID (numeric IDs fail on Mobilis) — set the sender ID in
# the Twilio console; TWILIO_FROM_NUMBER is the API "From" identity.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# WhatsApp Business via Meta Cloud API (required when MESSAGE_PROVIDER=whatsapp
# or whatsapp-first). No BSP: direct Graph API calls, per-message billing.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Optional: approved template for business-initiated WhatsApp messages.
# Meta requires a pre-approved template outside the 24h customer-service
# window. When set, the provider sends a template message carrying the
# rendered body as its parameter; when unset, it sends free text (works in
# the sandbox and inside the 24h window). Approval is a lead-time item —
# see docs/messaging-production.md.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="fr"

# ── Vercel Blob (patient documents, Task 15) ────────────────────────────────
# Patient X-rays/photos are stored in a PRIVATE Vercel Blob store (never as
# public URLs). Create the store with access=private, e.g.:
#   npx vercel blob create-store <name> --access private --yes
# `vercel env pull` will NOT decrypt tokens marked "Sensitive" (it writes a
# [SENSITIVE] placeholder instead) — a token created via the store connection
# or the CLI pulls in plain text.
BLOB_READ_WRITE_TOKEN=""

# Identifier of the Blob store (store_...). Not read by the app code — it
# pairs with VERCEL_OIDC_TOKEN so the `vercel blob` CLI can authenticate.
BLOB_STORE_ID=""

# ── Cron (Task 9) ───────────────────────────────────────────────────────────
# Shared secret that authenticates Vercel Cron -> route handler calls.
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`; the routes also
# accept the same secret via an `x-cron-secret` header for manual/curl triggers.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Auth (Task 12) ──────────────────────────────────────────────────────────
# Site origin used for CSRF Origin/Referer checks, session cookie scoping,
# AND canonical/OG/sitemap absolute URLs (Task 23). No trailing slash.
# e.g. http://localhost:3000 locally; https://orthocare-clinic.vercel.app in prod.
APP_URL="http://localhost:3000"

# HMAC key that signs staff session cookies (`__Host-orthocare_session`).
# REQUIRED in any environment where staff log in. Generate with:
#   openssl rand -hex 32
# Rotating it logs every staff member out (safe, non-destructive).
SESSION_SECRET=""

# Seed-time password for the initial admin account (Task 3a). Comes from env,
# never hardcoded. Set this to a strong password before running `prisma db seed`.
# Not used in this task; present so the pattern is established early.
ADMIN_INITIAL_PASSWORD=""

# Seed-time email for the initial admin account. Defaults to admin@orthocare.com
# when unset. Only read by the seed script; changing it does not rename an
# already-created admin user (use a DB update for that).
ADMIN_EMAIL=""

# ── Observability (Task 23) ──────────────────────────────────────────────────
# Sentry DSN for error monitoring. Unset locally (Sentry stays disabled and the
# build stays green). Set in staging + production.
# Privacy: client/server configs enforce sendDefaultPii:false + beforeSend
# scrubbing (request bodies stripped, /appointment/[token] masked).
SENTRY_DSN=""
# Optional: separate DSN env for Vercel integration (same value as SENTRY_DSN).
# NEXT_PUBLIC_SENTRY_DSN=""
