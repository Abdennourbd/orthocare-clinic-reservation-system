// Ortho'Care Clinic — Prisma schema
// Tasks 1 & 3a: rate-limit store, auth, patients, services, appointments.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Rate-limit counters for public endpoints (Task 1).
model RateLimitCounter {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

enum Role {
  ADMIN
  RECEPTIONIST
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(RECEPTIONIST)
  active             Boolean  @default(true)
  
  // Auth control
  tokenVersion       Int      @default(0)
  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patientsCreated    Patient[] @relation("PatientCreatedBy")
  patientsUpdated    Patient[] @relation("PatientUpdatedBy")
  scheduleExceptions ScheduleException[]
  smsMessagesSent    SmsMessage[]
  notifications      Notification[]
  auditLogs          AuditLog[]
}

model Patient {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  phone              String    // as typed
  phoneE164          String    // normalized
  email              String?
  birthDate          DateTime?
  notes              String?
  
  // Consent & opt-out
  consentAt          DateTime?
  consentVersion     String?
  messagingOptOut    Boolean   @default(false)
  
  // Messaging channel preferences (Task 7)
  // Language the patient booked in — later SMS/WhatsApp tasks read it so they
  // don't have to ask again. WhatsApp opt-in is Meta's documented-opt-in
  // requirement for business-initiated messages.
  preferredLocale    String    @default("fr")
  whatsappOptIn      Boolean   @default(false)
  
  // Erasure request
  anonymizedAt       DateTime?
  
  // Soft-delete
  active             Boolean   @default(true)
  
  // Audit
  createdById        String?
  createdBy          User?     @relation("PatientCreatedBy", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          User?     @relation("PatientUpdatedBy", fields: [updatedById], references: [id])
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointments       Appointment[]
  waitlistEntries    WaitlistEntry[]
  smsMessages        SmsMessage[]

  @@index([phoneE164])
}

model Service {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               Json      // {fr, ar, en}
  description        Json      // {fr, ar, en}
  durationMinutes    Int
  price              Int?
  currency           String    @default("DZD")
  
  active             Boolean   @default(true)
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointments       Appointment[]
  scheduleExceptions ScheduleException[]
  waitlistEntries    WaitlistEntry[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum AppointmentSource {
  ONLINE
  MANUAL
}

enum CancelReason {
  STAFF
  PATIENT_SELF_SERVICE
  AUTO_EXPIRED
  CLOSURE
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id])
  
  serviceId          String
  service            Service           @relation(fields: [serviceId], references: [id])
  
  startTime          DateTime          // UTC
  endTime            DateTime          // UTC (= start + service.duration)
  
  status             AppointmentStatus @default(PENDING)
  source             AppointmentSource @default(ONLINE)
  
  // Actor info
  createdByUserId    String?
  confirmedByUserId  String?
  
  // Status timestamps
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       CancelReason?
  completedAt        DateTime?
  noShowAt           DateTime?
  
  // Delivery idempotency
  reminderSentAt     DateTime?
  
  // Reserved for v2 (second chair)
  resourceId         String?
  
  visitNotes         String?
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  smsMessages        SmsMessage[]
  selfServiceTokens  SelfServiceToken[]
}

// -----------------------------------------------------------------------------
// Task 3b: Content Schema (Settings, Closures, Public Content)
// -----------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleException {
  id          String   @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(true)
  startTime   String?  // HH:mm if not allDay
  endTime     String?  // HH:mm if not allDay
  reason      Json     // {fr, ar, en}
  
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([startDate])
}

model Testimonial {
  id        String   @id @default(cuid())
  key       String   @unique
  author    Json     // {fr, ar, en} (could be simple string but localized allows translation)
  content   Json     // {fr, ar, en}
  rating    Int      @default(5)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  key       String   @unique
  question  Json     // {fr, ar, en}
  answer    Json     // {fr, ar, en}
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  key       String   @unique
  imageUrl  String
  caption   Json     // {fr, ar, en}
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Cancellation watch (patient-initiated waitlist, created at booking time)
// and staff-added waitlist entries (Task 17). Both are notified by the
// slot-freed event subscriber on matching cancellations.
// ----------------------------------------------------------------------------

enum WaitlistSource {
  PATIENT // self-service, offered at the end of the public booking wizard
  STAFF   // added from the admin dashboard
}

model WaitlistEntry {
  id         String         @id @default(cuid())
  patientId  String
  patient    Patient        @relation(fields: [patientId], references: [id])
  serviceId  String
  service    Service        @relation(fields: [serviceId], references: [id])

  // Watched clinic-local dates, each stored as that date's UTC midnight
  // (Africa/Algiers has no DST, so the mapping is stable). All date maths
  // on these values goes through lib/time/clinicTime.ts.
  preferredDates DateTime[]

  source     WaitlistSource

  active     Boolean        @default(true)
  // Set when the patient has been notified; entries are deactivated on
  // notification (one notification per entry in v1 — the patient can
  // re-watch if they miss it).
  notifiedAt DateTime?

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([serviceId, active])
}

// -----------------------------------------------------------------------------
// Task 7: Messaging (SmsMessage + Notification) — 3c schema slice.
//
// Every outbound message is recorded in `SmsMessage` regardless of channel
// (SMS or WhatsApp later); `provider` records which channel was actually used
// so delivery cost and WhatsApp coverage can be measured. The unique index on
// (appointmentId, type) makes automated sends idempotent: a retried cron or a
// retried route can never message the same appointment twice.
// -----------------------------------------------------------------------------

enum SmsMessageType {
  BOOKING_RECEIVED // "request received, we will call to confirm" (Task 7)
  CONFIRMATION     // staff confirmed after the phone call (Task 14); carries the self-service link (Task 8)
  REMINDER         // 24h-before reminder (Task 9)
  NO_SHOW          // no-show follow-up (Task 9)
  MANUAL           // staff single SMS (Task 16)
  RESCHEDULE       // appointment moved (Tasks 8/14); carries the rotated self-service link (Task 8)
  CANCELLED        // appointment cancelled by the patient via the self-service link (Task 8) or staff (Task 14)
  DELAY            // broadcast delay template (Task 16)
  WAITLIST         // slot-freed offer (Task 17)
  EXPIRED          // stale PENDING auto-cancelled (Task 9)
}

enum SmsStatus {
  SENDING
  SENT
  FAILED
}

model SmsMessage {
  id            String         @id @default(cuid())
  to            String         // E.164 recipient
  body          String
  patientId     String?
  patient       Patient?       @relation(fields: [patientId], references: [id])
  type          SmsMessageType
  templateId    String?        // lineage to the Settings template key
  batchId       String?        // broadcast grouping (Task 16)
  provider      String         // "mock" | "twilio" | "whatsapp" — channel used
  status        SmsStatus
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  sentById      String?
  sentBy        User?          @relation(fields: [sentById], references: [id])
  error         String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  // Idempotency guard for automated sends: one message of a given type per
  // appointment. (MANUAL/broadcast messages have no appointmentId, so NULLs
  // are not constrained — Postgres unique indexes allow multiple NULLs.)
  @@unique([appointmentId, type])
  @@index([patientId])
  @@index([batchId])
}

enum NotificationType {
  NEW_BOOKING
  CANCELLATION
  WAITLIST_MATCH
  NO_SHOW_ALERT
  PENDING_EXPIRED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// -----------------------------------------------------------------------------
// Task 8: Self-service link (SelfServiceToken) — delivered now.
//
// A revocable capability URL embedded in the confirmation SMS. Grants exactly
// two actions: cancel the appointment, or reschedule it into an available
// slot. ONLY the SHA-256 hash of the raw token is stored (`tokenHash`); the
// raw token is returned to the caller once (to build the SMS link) and never
// persisted, so a DB leak cannot mint live tokens. Replay protection: a token
// is rejected once `usedAt` or `revokedAt` is set, and after `expiresAt`.
// Rescheduling revokes the previous token and issues a fresh one (rotation).
// -----------------------------------------------------------------------------

model SelfServiceToken {
  id            String       @id @default(cuid())
  /** SHA-256 of the raw token. The raw token is never stored. */
  tokenHash     String       @unique
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])
  /** Set on a single-use action (cancel). */
  usedAt        DateTime?
  /** Set when the token is rotated (reschedule) or revoked. */
  revokedAt     DateTime?
  expiresAt     DateTime
  createdAt     DateTime     @default(now())

  @@index([appointmentId])
}

// -----------------------------------------------------------------------------
// Audit logging — delivered NOW (ahead of Task 12) because the
// patient-initiated actions of Task 8 (and the SYSTEM actions of Tasks 9/17)
// need an actor model (`STAFF | SYSTEM | PATIENT`) that a userId-only helper
// could not express. Plan.md §Audit logging. Task 12 builds the admin read
// surface + authorization matrix on top of this model.
//
// Append-only: the application never updates or deletes AuditLog rows.
// -----------------------------------------------------------------------------

enum AuditActorType {
  STAFF
  SYSTEM
  PATIENT
}

enum AuditAction {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  APPOINTMENT_AUTO_CANCELLED
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_ANONYMIZED
  SMS_SENT
  PATIENT_DOCUMENT_UPLOADED
  PATIENT_DOCUMENT_DELETED
  TEAM_MEMBER_CREATED
  TEAM_MEMBER_DEACTIVATED
  TEAM_MEMBER_ROLE_CHANGED
  SETTINGS_UPDATED
  CLOSURE_CREATED
  CLOSURE_DELETED
  WAITLIST_ENTRY_ADDED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  PASSWORD_RESET
  PATIENT_RECORD_VIEWED
  PATIENT_DOCUMENT_DOWNLOADED
  EXPORT_GENERATED
  AUDIT_VIEWED
  SELF_SERVICE_CANCELLED
  SELF_SERVICE_RESCHEDULED
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  /** Null for SYSTEM and PATIENT actors (no staff user). */
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  detail     Json
  ipAddress  String?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
