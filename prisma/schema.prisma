// Ortho'Care Clinic — Prisma schema
// Tasks 1 & 3a: rate-limit store, auth, patients, services, appointments.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Rate-limit counters for public endpoints (Task 1).
model RateLimitCounter {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

enum Role {
  ADMIN
  RECEPTIONIST
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(RECEPTIONIST)
  active             Boolean  @default(true)
  
  // Auth control
  tokenVersion       Int      @default(0)
  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patientsCreated    Patient[] @relation("PatientCreatedBy")
  patientsUpdated    Patient[] @relation("PatientUpdatedBy")
  visitsCreated      Visit[]
  patientDocumentsUploaded PatientDocument[] @relation("PatientDocumentUploadedBy")
  patientDocumentsDeleted  PatientDocument[] @relation("PatientDocumentDeletedBy")
  scheduleExceptions ScheduleException[]
  smsMessagesSent    SmsMessage[]
  smsBroadcasts      SmsBroadcast[]
  notifications      Notification[]
  auditLogs          AuditLog[]
}

// -----------------------------------------------------------------------------
// PATIENT HEALTH DATA. Identity (names, phone, email, birthDate), free-text
// `notes` and messaging consent. None of it may reach a log, an error message,
// a URL or an audit `detail` — those carry ids and field names only. Erasure is
// soft (`anonymizedAt` + `active`): the row survives so history and KPI counts
// stay exact, every identifying field is blanked in one transaction.
//
// `firstNameNormalized` / `lastNameNormalized` (Task 13 step 9) are derived
// copies of the two name fields, folded by `normalizeName()` (lowercase, Latin
// accents and Arabic diacritics/tatweel stripped, whitespace collapsed) so the
// staff search finds a record whether the name was typed in French or in
// Arabic, whatever the surface spelling. Same motive as `phone`/`phoneE164`
// just below. Same sensitivity as the names they derive from: never in an API
// select, and blanked by `anonymizePatient()` like the rest.
// -----------------------------------------------------------------------------
model Patient {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  // Search-only derived copies, maintained by every write path. Nullable on
  // purpose: no `unaccent` extension exists here to compute them in SQL, so
  // they are filled in TypeScript (`npm run db:backfill-patient-names` for the
  // rows that predate Task 13 step 9a).
  firstNameNormalized String?
  lastNameNormalized  String?
  phone              String    // as typed
  phoneE164          String    // normalized
  email              String?
  birthDate          DateTime?
  notes              String?
  
  // Consent & opt-out
  consentAt          DateTime?
  consentVersion     String?
  messagingOptOut    Boolean   @default(false)
  
  // Messaging channel preferences (Task 7)
  // Language the patient booked in — later SMS/WhatsApp tasks read it so they
  // don't have to ask again. WhatsApp opt-in is Meta's documented-opt-in
  // requirement for business-initiated messages.
  preferredLocale    String    @default("fr")
  whatsappOptIn      Boolean   @default(false)
  
  // Erasure request
  anonymizedAt       DateTime?
  
  // Soft-delete
  active             Boolean   @default(true)
  
  // Audit
  createdById        String?
  createdBy          User?     @relation("PatientCreatedBy", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          User?     @relation("PatientUpdatedBy", fields: [updatedById], references: [id])
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointments       Appointment[]
  waitlistEntries    WaitlistEntry[]
  smsMessages        SmsMessage[]
  visits             Visit[]
  documents          PatientDocument[]

  @@index([phoneE164])
  // Composite (ONE index on the pair, not two single-column ones), and
  // deliberately NOT a search accelerator: the step-9b search filters with
  // `contains` -> `LIKE '%…%'`, and a leading wildcard can never use a B-tree,
  // with or without this index. Only `pg_trgm` would help there, and no new
  // Postgres extension is allowed in this project (task-13.md, arbitration of
  // 2026-08-28). What this index does serve is a future exact-equality lookup
  // on the normalized (firstName, lastName) pair. Expect nothing more from it.
  @@index([firstNameNormalized, lastNameNormalized])
}

model Service {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               Json      // {fr, ar, en}
  description        Json      // {fr, ar, en}
  durationMinutes    Int
  price              Int?
  currency           String    @default("DZD")
  
  active             Boolean   @default(true)
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointments       Appointment[]
  scheduleExceptions ScheduleException[]
  waitlistEntries    WaitlistEntry[]
  visits             Visit[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum AppointmentSource {
  ONLINE
  MANUAL
}

enum CancelReason {
  STAFF
  PATIENT_SELF_SERVICE
  AUTO_EXPIRED
  CLOSURE
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id])
  
  serviceId          String
  service            Service           @relation(fields: [serviceId], references: [id])
  
  startTime          DateTime          // UTC
  endTime            DateTime          // UTC (= start + service.duration)
  
  status             AppointmentStatus @default(PENDING)
  source             AppointmentSource @default(ONLINE)
  
  // Actor info
  createdByUserId    String?
  confirmedByUserId  String?
  
  // Status timestamps
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       CancelReason?
  completedAt        DateTime?
  noShowAt           DateTime?
  
  // Delivery idempotency
  reminderSentAt     DateTime?
  
  // Reserved for v2 (second chair)
  resourceId         String?
  
  visitNotes         String?
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  smsMessages        SmsMessage[]
  selfServiceTokens  SelfServiceToken[]
}

// -----------------------------------------------------------------------------
// Task 13: Visit — manually recorded patient history.
//
// A patient's history is `COMPLETED` appointments UNION `Visit` rows. This
// table carries the care the appointment book cannot know about: treatments
// given before the clinic used this system, and walk-in patients treated
// without ever booking a slot. plan.md §Domain / Data Model.
//
// PATIENT HEALTH DATA. `notes` and `treatment` are free-text clinical notes,
// as confidential as `Appointment.visitNotes`: they must never reach a log, an
// error message, a URL or an audit `detail`. An erasure request clears both
// while keeping the row, so history and KPI counts stay exact.
//
// Deletion behaviour (Prisma defaults, spelled out because it is a data-loss
// decision): `patient` is required -> ON DELETE RESTRICT, so a patient with
// history can never be hard-deleted (erasure is the soft path, `anonymizedAt`).
// `service` and `createdBy` are optional -> ON DELETE SET NULL: losing the
// service link or the staff attribution must never destroy the visit itself.
// -----------------------------------------------------------------------------

model Visit {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])

  date        DateTime // UTC, like every timestamp in this schema

  // Optional: a walk-in treatment may match no catalogue service.
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])

  /** CONSULTATION | TRAITEMENT | CONTROLE | URGENCE | AUTRE. Kept as String,
   *  not a Prisma enum, so adding a category later needs no migration. */
  type        String
  /** Free-text clinical note — confidential. */
  notes       String?
  /** Free-text description of the treatment given — confidential. */
  treatment   String?

  // Staff attribution. Nullable: rows imported from the paper records have no
  // author; the AuditLog (VISIT_CREATED) remains the authoritative trail.
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The timeline query is always "this patient's visits, most recent first".
  @@index([patientId, date])
}

// -----------------------------------------------------------------------------
// Task 15: PatientDocument — files attached to a patient record, in practice
// X-rays. plan.md §Domain / Data Model.
//
// PATIENT HEALTH DATA, the most sensitive rows of this schema. `blobKey` is the
// pathname of a PRIVATE Vercel blob (`access: "private"`, plan.md:111-112),
// never a public URL, and it is never returned to a client: every download goes
// through GET /api/admin/documents/[id], which re-checks the session and
// streams the file itself. `name` is the uploader's original filename —
// patient-adjacent data (it often carries the patient's name or a diagnosis),
// so it must never reach a log, an error message, a URL or an audit `detail`.
// `mimeType` is only ever written after validation against the allow-list of
// src/lib/documents/mime.ts; the column itself enforces nothing.
//
// Deletion is soft (`deletedAt` / `deletedById`), as everywhere in this schema:
// the row survives so the AuditLog trail stays readable, while the blob itself
// is really erased from storage.
//
// Deletion behaviour of the foreign keys (Prisma defaults, spelled out because
// it is a data-loss decision): `patient` is required -> ON DELETE RESTRICT, so
// a patient holding documents can never be hard-deleted (erasure is the soft
// path, `anonymizedAt`). `uploadedBy` / `deletedBy` are optional -> ON DELETE
// SET NULL: losing a staff account must never destroy the document's trace.
// -----------------------------------------------------------------------------

model PatientDocument {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])

  /** Original filename, as uploaded — patient-adjacent, never logged. */
  name         String
  /** Validated against the allow-list of src/lib/documents/mime.ts. */
  mimeType     String
  sizeBytes    Int
  /** Pathname of a PRIVATE Vercel blob, never a public URL and never returned
   *  to a client. Unique: one row per stored object, so a retried upload can
   *  never leave two rows pointing at the same file — and deleting one can
   *  never orphan the other. */
  blobKey      String    @unique

  uploadedById String?
  uploadedBy   User?     @relation("PatientDocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())

  // Soft delete: the row stays for the audit trail, the blob is really removed.
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?     @relation("PatientDocumentDeletedBy", fields: [deletedById], references: [id])

  // The list query is always "this patient's documents, most recent first".
  @@index([patientId, uploadedAt])
}

// -----------------------------------------------------------------------------
// Task 3b: Content Schema (Settings, Closures, Public Content)
// -----------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleException {
  id          String   @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(true)
  startTime   String?  // HH:mm if not allDay
  endTime     String?  // HH:mm if not allDay
  reason      Json     // {fr, ar, en}
  
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([startDate])
}

model Testimonial {
  id        String   @id @default(cuid())
  key       String   @unique
  author    Json     // {fr, ar, en} (could be simple string but localized allows translation)
  content   Json     // {fr, ar, en}
  rating    Int      @default(5)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  key       String   @unique
  question  Json     // {fr, ar, en}
  answer    Json     // {fr, ar, en}
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  key       String   @unique
  imageUrl  String
  caption   Json     // {fr, ar, en}
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Cancellation watch (patient-initiated waitlist, created at booking time)
// and staff-added waitlist entries (Task 17). Both are notified by the
// slot-freed event subscriber on matching cancellations.
// ----------------------------------------------------------------------------

enum WaitlistSource {
  PATIENT // self-service, offered at the end of the public booking wizard
  STAFF   // added from the admin dashboard
}

model WaitlistEntry {
  id         String         @id @default(cuid())
  patientId  String
  patient    Patient        @relation(fields: [patientId], references: [id])
  serviceId  String
  service    Service        @relation(fields: [serviceId], references: [id])

  // Watched clinic-local dates, each stored as that date's UTC midnight
  // (Africa/Algiers has no DST, so the mapping is stable). All date maths
  // on these values goes through lib/time/clinicTime.ts.
  preferredDates DateTime[]

  source     WaitlistSource

  active     Boolean        @default(true)
  // Set when the patient has been notified; entries are deactivated on
  // notification (one notification per entry in v1 — the patient can
  // re-watch if they miss it).
  notifiedAt DateTime?

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([serviceId, active])
}

// -----------------------------------------------------------------------------
// Task 7: Messaging (SmsMessage + Notification) — 3c schema slice.
// Task 16 adds SmsBroadcast below: one row per staff delay-broadcast batch.
//
// Every outbound message is recorded in `SmsMessage` regardless of channel
// (SMS or WhatsApp later); `provider` records which channel was actually used
// so delivery cost and WhatsApp coverage can be measured. The unique index on
// (appointmentId, type) makes automated sends idempotent: a retried cron or a
// retried route can never message the same appointment twice.
// -----------------------------------------------------------------------------

enum SmsMessageType {
  BOOKING_RECEIVED // "request received, we will call to confirm" (Task 7)
  CONFIRMATION     // staff confirmed after the phone call (Task 14); carries the self-service link (Task 8)
  REMINDER         // 24h-before reminder (Task 9)
  NO_SHOW          // no-show follow-up (Task 9)
  MANUAL           // staff single SMS (Task 16)
  RESCHEDULE       // appointment moved (Tasks 8/14); carries the rotated self-service link (Task 8)
  CANCELLED        // appointment cancelled by the patient via the self-service link (Task 8) or staff (Task 14)
  DELAY            // broadcast delay template (Task 16)
  WAITLIST         // slot-freed offer (Task 17)
  EXPIRED          // stale PENDING auto-cancelled (Task 9)
}

enum SmsStatus {
  SENDING
  SENT
  FAILED
}

model SmsMessage {
  id            String         @id @default(cuid())
  to            String         // E.164 recipient
  body          String
  patientId     String?
  patient       Patient?       @relation(fields: [patientId], references: [id])
  type          SmsMessageType
  templateId    String?        // lineage to the Settings template key
  batchId       String?        // broadcast grouping (Task 16)
  provider      String         // "mock" | "twilio" | "whatsapp" — channel used
  status        SmsStatus
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  sentById      String?
  sentBy        User?          @relation(fields: [sentById], references: [id])
  error         String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  // Idempotency guard for automated sends: one message of a given type per
  // appointment. (MANUAL/broadcast messages have no appointmentId, so NULLs
  // are not constrained — Postgres unique indexes allow multiple NULLs.)
  @@unique([appointmentId, type])
  @@index([patientId])
  @@index([batchId])
}

// -----------------------------------------------------------------------------
// Task 16: SmsBroadcast — one row per staff delay-broadcast batch.
//
// `id` doubles as the `batchId` stamped on each SmsMessage of the batch, so
// the dashboard groups the individual rows without a join table. The unique
// `idempotencyKey` is the double-click guard: a P2002 on it means the batch
// was already sent — the route returns the existing row and sends nothing.
// The counters record what the dispatcher did: `sentCount` delivered,
// `suppressedCount` skipped because the patient opted out or is inactive
// (sendMessage returned null), `failedCount` provider failures. `sentBy` is
// optional -> ON DELETE SET NULL: losing the staff account must never destroy
// the batch record.
// -----------------------------------------------------------------------------

model SmsBroadcast {
  id              String   @id @default(cuid()) // doubles as batchId on its SmsMessage rows
  date            String   // clinic-local YYYY-MM-DD targeted
  delayMinutes    Int
  idempotencyKey  String   @unique // double-click protection: P2002 → return existing batch, send nothing
  recipientCount  Int
  sentCount       Int      @default(0)
  suppressedCount Int      @default(0) // opt-out/inactive — dispatcher returned null
  failedCount     Int      @default(0)
  sentById        String?
  sentBy          User?    @relation(fields: [sentById], references: [id])
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

enum NotificationType {
  NEW_BOOKING
  CANCELLATION
  WAITLIST_MATCH
  NO_SHOW_ALERT
  PENDING_EXPIRED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// -----------------------------------------------------------------------------
// Task 8: Self-service link (SelfServiceToken) — delivered now.
//
// A revocable capability URL embedded in the confirmation SMS. Grants exactly
// two actions: cancel the appointment, or reschedule it into an available
// slot. ONLY the SHA-256 hash of the raw token is stored (`tokenHash`); the
// raw token is returned to the caller once (to build the SMS link) and never
// persisted, so a DB leak cannot mint live tokens. Replay protection: a token
// is rejected once `usedAt` or `revokedAt` is set, and after `expiresAt`.
// Rescheduling revokes the previous token and issues a fresh one (rotation).
// -----------------------------------------------------------------------------

model SelfServiceToken {
  id            String       @id @default(cuid())
  /** SHA-256 of the raw token. The raw token is never stored. */
  tokenHash     String       @unique
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])
  /** Set on a single-use action (cancel). */
  usedAt        DateTime?
  /** Set when the token is rotated (reschedule) or revoked. */
  revokedAt     DateTime?
  expiresAt     DateTime
  createdAt     DateTime     @default(now())

  @@index([appointmentId])
}

// -----------------------------------------------------------------------------
// Audit logging — delivered NOW (ahead of Task 12) because the
// patient-initiated actions of Task 8 (and the SYSTEM actions of Tasks 9/17)
// need an actor model (`STAFF | SYSTEM | PATIENT`) that a userId-only helper
// could not express. Plan.md §Audit logging. Task 12 builds the admin read
// surface + authorization matrix on top of this model.
//
// Append-only: the application never updates or deletes AuditLog rows.
// -----------------------------------------------------------------------------

enum AuditActorType {
  STAFF
  SYSTEM
  PATIENT
}

enum AuditAction {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  APPOINTMENT_AUTO_CANCELLED
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_ANONYMIZED
  VISIT_CREATED
  SMS_SENT
  PATIENT_DOCUMENT_UPLOADED
  PATIENT_DOCUMENT_DELETED
  TEAM_MEMBER_CREATED
  TEAM_MEMBER_DEACTIVATED
  TEAM_MEMBER_ROLE_CHANGED
  SETTINGS_UPDATED
  CLOSURE_CREATED
  CLOSURE_DELETED
  WAITLIST_ENTRY_ADDED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  PASSWORD_RESET
  PATIENT_RECORD_VIEWED
  PATIENT_DOCUMENT_DOWNLOADED
  EXPORT_GENERATED
  AUDIT_VIEWED
  SELF_SERVICE_CANCELLED
  SELF_SERVICE_RESCHEDULED
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  /** Null for SYSTEM and PATIENT actors (no staff user). */
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  detail     Json
  ipAddress  String?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
